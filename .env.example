VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_TRANSPORT=bff
# Local loopback development only. Never enable in a deployed build.
VITE_ALLOW_DIRECT_AUTH=false
VITE_LOCAL_PILOT_PHOTO=false
VITE_CAPSULE_LOCAL_PILOT=false

# Server-side BFF variables. Configure in the runtime secret manager, never in a Vite build.
NODE_ENV=development
AUTH_SITE_ORIGIN=http://localhost:5173
AUTH_PORT=8787
AUTH_INSECURE_LOCAL_COOKIE=1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
