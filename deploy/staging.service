[Unit]
Description=AI stylist closed staging gate
After=network.target

[Service]
Type=simple
User=stylist
Group=stylist
WorkingDirectory=/opt/stylist/current
EnvironmentFile=/etc/stylist/staging.env
ExecStart=/usr/bin/node /opt/stylist/current/scripts/server-start.mjs
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=64M
TemporaryFileSystem=/var/tmp:rw,nosuid,nodev,noexec,size=16M
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
KillMode=control-group
TimeoutStopSec=25s
StateDirectory=stylist
StateDirectoryMode=0700
ReadWritePaths=/var/lib/stylist
LimitCORE=0
MemorySwapMax=0
MemoryMax=1G
TasksMax=64
Environment=NODE_ENV=production
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
StandardOutput=null
StandardError=null

# Intentionally no Install/WantedBy: do not enable automatic boot startup.
